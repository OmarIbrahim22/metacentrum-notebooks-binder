# --- S3 (CESNET Object Storage) ---
# Documentation: https://docs.du.cesnet.cz/en/docs/object-storage-s3/s3-service
# Keys and endpoint address: https://gatekeeper.du.cesnet.cz
S3_ENDPOINT=https://s3.cl4.du.cesnet.cz
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=your-test-bucket

# --- EOSC CZ / NRP (Invenio) ---
# Documentation: https://docs.nrp.eosc.cz/
NRP_BASE=https://datarepo.eosc.cz
NRP_TOKEN=REPLACE_ME
# Optional: record model to create drafts in (default: datasets)
# NRP_MODEL=datasets

# --- OpenStack API ---
# Documentation: https://docs.platforms.cloud.e-infra.cz/en/docs/iaas-cloud/technical-reference/brno-g2-site
# Auth URL and region are in the openrc/clouds.yaml file downloaded with the credential
OS_AUTH_URL=https://identity.brno.openstack.cloud.e-infra.cz/v3
OS_REGION_NAME=Brno1
OS_APPLICATION_CREDENTIAL_ID=REPLACE_ME
OS_APPLICATION_CREDENTIAL_SECRET=REPLACE_ME

# --- Open WebUI Chat API ---
# Documentation: https://docs.cerit.io/en/docs/ai-as-a-service/chat-ai
EINFRA_AI_BASE_URL=https://llm.ai.e-infra.cz/v1
EINFRA_AI_TOKEN=REPLACE_ME
# Optional: model to chat with (default: picked from the model list)
# EINFRA_AI_MODEL=mini

# --- GPU/Container demo ---
CONTAINER_RUNTIME=apptainer
# Optional: path to a local .sif image (default: images are pulled from Docker Hub)
# CONTAINER_IMAGE=/path/to/image.sif
